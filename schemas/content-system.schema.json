{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/client-content-system/schemas/content-system.schema.json",
  "title": "Client Content System Manifest",
  "description": "Contract for a private client workspace manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client",
    "active_90_day_objective",
    "content_pillars",
    "cadence",
    "cta_ladder",
    "locations",
    "approval_gate",
    "fatigue_rules",
    "last_refresh_dates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "display_name"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "active_90_day_objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "success_metric", "target_value"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "success_metric": { "type": "string", "minLength": 1 },
        "target_value": { "type": "string", "minLength": 1 }
      }
    },
    "content_pillars": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/contentPillar" }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle_days", "days"],
      "properties": {
        "cycle_days": { "type": "integer", "const": 6 },
        "days": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/cadenceDay" }
        }
      }
    },
    "cta_ladder": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ctaStep" }
    },
    "locations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_context",
        "demand_map",
        "trend_library",
        "transcript_index",
        "content_history"
      ],
      "properties": {
        "content_context": { "$ref": "#/$defs/relativePath" },
        "demand_map": { "$ref": "#/$defs/relativePath" },
        "trend_library": { "$ref": "#/$defs/relativePath" },
        "transcript_index": { "$ref": "#/$defs/relativePath" },
        "content_history": { "$ref": "#/$defs/relativePath" }
      }
    },
    "approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_before", "approved_by", "record_location"],
      "properties": {
        "required_before": {
          "type": "string",
          "enum": ["planning", "production", "distribution"]
        },
        "approved_by": { "type": "string", "minLength": 1 },
        "record_location": { "type": "string", "minLength": 1 }
      }
    },
    "fatigue_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookback_days",
        "max_reuses_per_topic",
        "max_reuses_per_hook",
        "action_when_triggered"
      ],
      "properties": {
        "lookback_days": { "type": "integer", "minimum": 1 },
        "max_reuses_per_topic": { "type": "integer", "minimum": 0 },
        "max_reuses_per_hook": { "type": "integer", "minimum": 0 },
        "action_when_triggered": { "type": "string", "minLength": 1 }
      }
    },
    "last_refresh_dates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_context",
        "demand_map",
        "trend_library",
        "transcript_index",
        "content_history"
      ],
      "properties": {
        "content_context": { "$ref": "#/$defs/refreshDate" },
        "demand_map": { "$ref": "#/$defs/refreshDate" },
        "trend_library": { "$ref": "#/$defs/refreshDate" },
        "transcript_index": { "$ref": "#/$defs/refreshDate" },
        "content_history": { "$ref": "#/$defs/refreshDate" }
      }
    }
  },
  "$defs": {
    "contentPillar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "cadenceDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "focus"],
      "properties": {
        "day": { "type": "integer", "minimum": 1, "maximum": 6 },
        "focus": { "type": "string", "minLength": 1 }
      }
    },
    "ctaStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "call_to_action", "destination"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "call_to_action": { "type": "string", "minLength": 1 },
        "destination": { "type": "string", "minLength": 1 }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "refreshDate": {
      "type": ["string", "null"],
      "format": "date"
    }
  }
}
