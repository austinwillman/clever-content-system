{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/clever-content-system/schemas/content-system.schema.json",
  "title": "Clever Content System Manifest",
  "description": "Portable description of a private client workspace manifest. Runtime enforcement lives in lib/config.mjs; this document exists so the contract is readable and portable outside the Node engine.",
  "type": "object",
  "required": [
    "schema_version",
    "client_id",
    "client_name",
    "initiative",
    "pillars",
    "content_output",
    "cta_classes",
    "cta_destinations",
    "fatigue",
    "approval_gate",
    "assets",
    "research_sources",
    "last_research_refresh_date",
    "last_content_history_refresh_date"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "client_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "client_name": { "type": "string", "minLength": 1 },
    "positioning": { "type": "string" },
    "initiative": {
      "type": "object",
      "required": ["id", "horizon_days", "objective"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "horizon_days": { "type": "integer", "minimum": 1 },
        "objective": { "type": "string", "minLength": 1 }
      }
    },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" }
        }
      }
    },
    "content_output": {
      "type": "object",
      "required": ["allowed_formats", "batch_size"],
      "properties": {
        "allowed_formats": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["video"] }
        },
        "batch_size": { "type": "integer", "minimum": 1 }
      }
    },
    "cta_classes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "cta_destinations": {
      "type": "object",
      "description": "Every declared CTA class needs at least one destination. A destination that is not live is recorded as available: false rather than omitted.",
      "additionalProperties": {
        "type": "object",
        "required": ["class", "available"],
        "properties": {
          "class": { "type": "string", "minLength": 1 },
          "available": { "type": "boolean" }
        }
      }
    },
    "fatigue": {
      "type": "object",
      "required": ["topic_cooldown_days", "max_hook_uses_per_seven_posts"],
      "properties": {
        "topic_cooldown_days": { "type": "integer", "minimum": 1 },
        "max_hook_uses_per_seven_posts": { "type": "integer", "minimum": 1, "maximum": 7 },
        "hook_frequency_window_posts": { "type": "integer", "minimum": 1 }
      }
    },
    "approval_gate": {
      "type": "object",
      "required": ["required_before", "approved_by", "record_location"],
      "properties": {
        "required_before": { "type": "string", "enum": ["production", "distribution"] },
        "approved_by": { "type": "string", "minLength": 1 },
        "record_location": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "object",
      "description": "Client-owned source declarations. approved_recording_ids, when present, is the exact set of transcript recordings the workspace expects.",
      "properties": {
        "approved_recording_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "assets": {
      "type": "object",
      "description": "Workspace-relative paths. Every path must resolve inside the workspace directory.",
      "required": [
        "context",
        "client_foundation",
        "topic_bank",
        "demand_map",
        "trend_library",
        "hook_library",
        "research_log",
        "transcript_index",
        "content_history"
      ],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "research_sources": {
      "type": "object",
      "description": "Declared research inputs and their honest availability. Both the foundation and batch_signal modes must be covered.",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "modes", "required", "subscription", "fallback"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["connected", "not_connected", "export_required", "optional", "unavailable"]
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["foundation", "batch_signal"] }
          },
          "required": { "type": "boolean" },
          "subscription": { "type": "string", "minLength": 1 },
          "fallback": { "type": "string", "minLength": 1 }
        }
      }
    },
    "last_research_refresh_date": { "type": "string" },
    "last_content_history_refresh_date": { "type": "string" }
  }
}
