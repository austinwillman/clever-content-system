{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/clever-content-system/schemas/content-candidate.schema.json",
  "title": "Content Candidate",
  "description": "Contract for a proposed content candidate. A candidate is a proposal. It is not approved, produced, distributed, or proven by default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "client_id",
    "status",
    "source",
    "audience_problem",
    "content_pillar",
    "core_claim",
    "supporting_evidence",
    "format",
    "cta_stage",
    "confidence",
    "approval"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "candidate_id": { "$ref": "#/$defs/identifier" },
    "client_id": {
      "$ref": "#/$defs/identifier",
      "description": "Must equal client.identifier in the active workspace manifest. Guards against cross-client contamination."
    },
    "batch_id": { "$ref": "#/$defs/identifier" },
    "status": {
      "type": "string",
      "enum": ["proposed", "refined", "held", "rejected", "approved_for_recording"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "references"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["transcript", "trend_signal", "research_note", "customer_conversation"]
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceReference" }
        }
      }
    },
    "audience_problem": { "type": "string", "minLength": 1 },
    "content_pillar": { "type": "string", "minLength": 1 },
    "proposed_hook_material": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Raw hook material drawn from the source. Not final hook copy."
    },
    "core_claim": { "type": "string", "minLength": 1 },
    "supporting_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceReference" },
      "description": "A material claim without evidence is not a candidate."
    },
    "format": { "type": "string", "enum": ["video", "text", "image", "carousel"] },
    "cta_stage": { "type": "string", "enum": ["awareness", "consideration", "conversion"] },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "ownership_confidence", "uncertainty"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "ownership_confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "uncertainty": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Stated gaps. An empty array asserts no known gaps."
        },
        "review_notes": { "type": "string" }
      }
    },
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording_id", "excerpt", "ownership_confidence"],
      "properties": {
        "recording_id": { "type": "string", "minLength": 1 },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "speaker": { "type": "string" },
        "excerpt": { "type": "string", "minLength": 1 },
        "ownership_confidence": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_type", "validation_status"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_type": {
          "type": "string",
          "enum": ["demand", "trend", "transcript", "research"]
        },
        "validation_status": {
          "type": "string",
          "enum": ["validated", "provisional", "qualitative_only", "unavailable"]
        },
        "note": { "type": "string" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["unapproved", "approved", "rejected"] },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string" },
        "record_reference": {
          "type": "string",
          "description": "Workspace-relative path to the approval record entry."
        }
      }
    }
  }
}
